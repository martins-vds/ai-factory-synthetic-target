        "holds",
        "reservations"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "Hold",
          "Member",
          "ISBN"
        ],
        "businessRules": [
          "Member and ISBN required",
          "Book must be on loan (not available)",
          "Borrower cannot hold own book",
          "No duplicate active hold per member/ISBN",
          "Member hold limit enforced",
          "Holds expire 30 days after placement",
          "Placement serialized with advisory lock"
        ],
        "crossDomainInteractions": [
          "Depends on Loan Management for active loan state"
        ]
      }
    },
