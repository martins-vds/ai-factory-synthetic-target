          "Return marking is transactional with row lock"
        ],
        "crossDomainInteractions": [
          "Provides active-loan lookup to Holds",
          "Loans are read by Fees and Reports"
        ]
      }
    },
    {
      "id": "domain:holds",
      "type": "domain",
      "name": "Holds",
      "summary": "Lets members queue a hold on a book that is currently on loan. Holds expire after 30 days and are subject to placement rules.",
