    {
      "id": "domain:loan-management",
      "type": "domain",
      "name": "Loan Management",
      "summary": "Handles lending books to members and recording their return. Loans carry a 14-day lending period from which the due date is computed.",
      "tags": [
        "loans",
        "lending",
        "core"
      ],
      "complexity": "simple",
      "domainMeta": {
        "entities": [
          "Loan",
          "Member",
          "ISBN"
        ],
        "businessRules": [
          "Due date = lent date + loan period (14 days)",
          "A loan is open until returnedOn is set",
          "Loans are exported as semicolon-separated lines for spreadsheet users"
        ],
        "crossDomainInteractions": [
          "Hold Management checks open loans to decide if a book can be held",
          "Fines & Payments derives late fees from loan due and return dates"
        ]
      }
    },
    {
      "id": "domain:hold-management",
      "type": "domain",
      "name": "Hold Management",
      "summary": "Lets members reserve a book that is currently on loan, and cancel or list active holds. Holds expire automatically after a fixed number of days.",
      "tags": [
        "holds",
        "reservations"
      ],
      "complexity": "moderate",
      "domainMeta": {
        "entities": [
          "Hold",
          "Loan",
          "Member",
          "ISBN"
        ],
        "businessRules": [
          "A hold requires the book to be currently on loan",
          "A member cannot hold a book they already have on loan",
          "A member cannot hold the same book twice",
          "Active hold limit per member (MAX_ACTIVE_HOLDS = 3)",
          "A hold is active until cancelled or expired"
        ],
        "crossDomainInteractions": [
          "Reads open loans from Loan Management to validate placement"
        ]
      }
    },
    {
      "id": "domain:fines-and-payments",
      "type": "domain",
      "name": "Fines & Payments",
      "summary": "Computes late fees for overdue loans and charges them through an external payment gateway.",
      "tags": [
        "fees",
        "payments",
        "external-integration"
      ],
      "complexity": "moderate",
      "domainMeta": {
        "entities": [
          "Loan",
          "Late fee",
          "Payment gateway"
        ],
        "businessRules": [
          "Fee is 25 cents per late day",
          "First 2 days are a grace period with no fee",
          "Fee is capped at 10 dollars",
          "Unreturned loans accrue fees up to today"
        ],
        "crossDomainInteractions": [
          "Uses loan due/return dates from Loan Management",
          "Calls external payment gateway (PAYMENT_GATEWAY_URL)"
        ]
      }
    },
