        "fees",
        "payments"
      ],
      "complexity": "moderate",
      "domainMeta": {
        "entities": [
          "Late fee",
          "Payment charge"
        ],
        "businessRules": [
          "25 cents per day late",
          "Fee capped at $10",
          "Waived when within 2 days of due date",
          "Unknown loans yield 404; gateway failure yields 502"
        ],
        "crossDomainInteractions": [
          "Reads loans from Loan Management",
          "Calls external gateway at PAYMENT_GATEWAY_URL"
        ]
      }
    },
