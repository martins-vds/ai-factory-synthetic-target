      "id": "domain:lending",
      "type": "domain",
      "name": "Lending",
      "summary": "Core lending of items to members: recording loans, listing them, and returning them. Loans are persisted via JPA/H2 and exposed through /loans with a ';'-separated export format that spreadsheet users rely on.",
      "tags": [
        "loans",
        "core"
      ],
      "complexity": "moderate",
      "domainMeta": {
        "entities": [
          "Loan"
        ],
        "businessRules": [
          "Due date is lent date + 14 days",
          "GET /loans output stays ';'-separated for spreadsheet compatibility"
        ],
        "crossDomainInteractions": [
          "Loan data feeds late fee calculation and payments in Fines & Payments"
        ]
      }
    },
    {
      "id": "domain:fines-payments",
